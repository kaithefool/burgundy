{
  "name": "burgundy",
  "version": "1.0.0",
  "description": "",
  "main": "server/bin/www",
  "scripts": {
    "cmd": "node server/bin/www",
    "up": "docker compose up --watch",
    "down": "docker compose down",
    "start": "run-p start:server start:assets",
    "start:server": "cd server && npm start",
    "start:assets": "cd assets && npm start",
    "i:server": "cd server && npm i",
    "i:assets": "cd assets && npm i",
    "postinstall": "npm run i:server && npm run i:assets",
    "postversion": "git push && git push --tags",
    "sync-fwk": "git fetch burgundy master:fwk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaithefool/burgundy.git"
  },
  "author": "Kai Lam <kai.chun.lam@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/eslint-parser": "^7.16.3",
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-react": "^7.16.0",
    "eslint": "^8.3.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsdoc": "^46.9.1",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "hygen": "^6.1.0"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
